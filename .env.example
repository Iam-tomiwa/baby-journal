# Neon Postgres connection string (https://console.neon.tech -> Connection string, "pooled")
DATABASE_URL=

# Cloudinary (https://console.cloudinary.com -> Settings -> API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# The passcode parents type to add or remove entries
PARENT_PASSCODE=

# Any long random string; signs the parent session cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=
